          "clicks"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "clicks": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "timeStampe": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ClickData": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "clicks": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "timeStamp": {
            "type": "string"
          }
        }
      },
      "Member": {
        "required": [
          "name",
          "role"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
