    "/api/clickgame/registerclicks": {
      "post": {
        "tags": [
          "ClickCompetition"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClickData"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClickData"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClickData"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/clickgame/{val}": {
      "get": {
        "tags": [
          "ClickCompetition"
        ],
        "parameters": [
          {
            "name": "val",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClickCompetitor"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClickCompetitor"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClickCompetitor"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClickCompetitor": {
        "required": [
